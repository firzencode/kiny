{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kiny-editor",
  "version": "0.11.0",
  "identifier": "com.kiny.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "launch",
        "title": "Kiny Editor",
        "width": 880,
        "height": 620,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/export-template/index.html"],
    "fileAssociations": [
      {
        "ext": ["kiw"],
        "name": "Kiny 项目",
        "description": "Kiny 项目文件",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}
